<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>TC_Fort_ReinforcedWall</defName>
    <label>армированная стена Терна</label>
    <description>Укрепление Корпуса Терна с массивными бронеплитами и датчиками. Амбразуры предназначены для огня сквозь укрытие; их CE-LoS требует отдельного теста.</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <designationCategory>Security</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <size>(1,1)</size>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <graphicData>
      <texPath>ThornCorps/Defense/Fort_ReinforcedWall</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>850</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Flammability>0.05</Flammability>
    </statBases>
    <costList>
      </costList>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <rotatable>true</rotatable>
    <comps>
      <li Class="CompProperties_Styleable"/>
    </comps>
    <costStuffCount>45</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
  </ThingDef>
